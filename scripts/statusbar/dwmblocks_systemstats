#!/usr/bin/env bash
set -euo pipefail

# ── Icons ─────────────────────────────────────────────────────────────
ICON_CPU="󰍛"
ICON_CPU_HOT=""
ICON_GPU="󰢮"
ICON_GPU_HOT=""
ICON_MEM=""

# ── Helpers ───────────────────────────────────────────────────────────
get_cpu_temp() {
    local temp
    # Try known CPU labels first
    temp=$(sensors 2>/dev/null | grep -m1 -E 'Tdie|Tctl|Package id 0|Core 0' \
        | grep -oE '[+-]?[0-9]+(\.[0-9]+)?°C' | head -n1 | tr -d '+°C' | cut -d. -f1)

    # Fallback: highest reasonable temp from any sensor
    if [[ -z "$temp" ]]; then
        temp=$(sensors 2>/dev/null | grep -oE '[+-]?[0-9]+(\.[0-9]+)?°C' \
            | sed 's/[+°C]//g' | awk '$1 > 20 && $1 < 120 {print int($1)}' \
            | sort -rn | head -n1)
    fi
    printf '%s' "${temp:-N/A}"
}

get_gpu_temp() {
    local temp
    # NVIDIA
    if command -v nvidia-smi >/dev/null 2>&1; then
        temp=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null | tr -d '[:space:]')
        [[ -n "$temp" && "$temp" =~ ^[0-9]+$ ]] && { printf '%s' "$temp"; return; }
    fi
    # AMD (edge = GPU die temp)
    temp=$(sensors 2>/dev/null | grep -m1 '^edge' \
        | grep -oE '[+-]?[0-9]+(\.[0-9]+)?°C' | head -n1 | tr -d '+°C' | cut -d. -f1)
    [[ -n "$temp" ]] && { printf '%s' "$temp"; return; }

    # Intel via sysfs
    for f in /sys/class/drm/card*/device/hwmon/hwmon*/temp1_input; do
        [[ -r "$f" ]] || continue
        temp=$(cat "$f" 2>/dev/null)
        [[ -n "$temp" && "$temp" =~ ^[0-9]+$ ]] && { printf '%.0f\n' "$((temp / 1000))"; return; }
    done
    printf 'N/A'
}

get_fan_speed() {
    local rpm
    rpm=$(sensors 2>/dev/null | grep -m1 -i 'fan' | grep -oE '[0-9]+' | head -n1)
    [[ -n "$rpm" && "$rpm" != "0" ]] && printf '%s RPM' "$rpm" || printf 'N/A'
}

get_mem() {
    free -m | awk '/^Mem/ {printf "%.1fG", $3/1024}'
}

get_cpu_usage() {
    local u1 n1 s1 i1 u2 n2 s2 i2
    read -r u1 n1 s1 i1 <<< "$(awk '/^cpu /{print $2,$3,$4,$5}' /proc/stat)"
    sleep 0.5
    read -r u2 n2 s2 i2 <<< "$(awk '/^cpu /{print $2,$3,$4,$5}' /proc/stat)"

    local used1=$((u1 + n1 + s1))  used2=$((u2 + n2 + s2))
    local total1=$((used1 + i1))    total2=$((used2 + i2))
    local diff=$((total2 - total1))

    [[ $diff -le 0 ]] && { echo "0"; return; }
    echo "$(( (used2 - used1) * 100 / diff ))"
}

# ── Gather data ───────────────────────────────────────────────────────
CPU_TEMP=$(get_cpu_temp)
GPU_TEMP=$(get_gpu_temp)
MEM_USE=$(get_mem)
FAN_SPEED=$(get_fan_speed)

# ── Styling ───────────────────────────────────────────────────────────
CPU_ICON="$ICON_CPU"
CPU_COLOR="#a3be8c"

if [[ "$CPU_TEMP" == "N/A" ]]; then
    CPU_COLOR="#d8dee9"
elif (( CPU_TEMP >= 76 )); then
    CPU_COLOR="#bf616a"
    CPU_ICON="$ICON_CPU_HOT"
elif (( CPU_TEMP >= 66 )); then
    CPU_COLOR="#ebcb8b"
fi

GPU_ICON="$ICON_GPU"
if [[ "$GPU_TEMP" == "N/A" ]]; then
    GPU_ICON="󰢮 ?"
elif (( GPU_TEMP >= 72 )); then
    GPU_ICON="$ICON_GPU_HOT"
fi

# ── Bar output (must be first stdout for dwmblocks) ───────────────────
printf ' %s %s°C  %s %s°C  %s %s \n' \
    "$GPU_ICON" "$GPU_TEMP" "$CPU_ICON" "$CPU_TEMP" "$ICON_MEM" "$MEM_USE"

# ── Click handlers ────────────────────────────────────────────────────
case "${BLOCK_BUTTON:-}" in
    1)
        setsid -f "${TERMINAL:-st}" -e htop >/dev/null 2>&1
        ;;
    3)
        CPU_USE=$(get_cpu_usage)
        notify-send -t 8000 -h "string:bgcolor:$CPU_COLOR" "System Stats" \
"CPU Load: ${CPU_USE}%
CPU Temp: ${CPU_TEMP}°C
GPU Temp: ${GPU_TEMP}°C
Memory:   ${MEM_USE}
Fan:      ${FAN_SPEED}"
        ;;
    6)
        setsid -f "${TERMINAL:-st}" -e "${EDITOR:-nvim}" "$0" >/dev/null 2>&1
        ;;
esac
