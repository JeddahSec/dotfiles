#!/usr/bin/env bash
# dwmblocks module: HTB target indicator
# Usage: dwmblocks-target          # output for DWM bar
#        dwmblocks-target set IP  # set target via dmenu or args
#        dwmblocks-target clear   # clear target

set -euo pipefail

TARGET_FILE="${TARGET_FILE:-$HOME/.target}"

# ── Icons (Nerd Font or FontAwesome) ──────────────────────────────────
ICON_NONE=""
ICON_IP=""
ICON_HOST=""
ICON_INVALID=""

# ── Validation ────────────────────────────────────────────────────────
is_ipv4() {
    local ip="$1" IFS='.' octets
    read -ra octets <<< "$ip"
    [[ ${#octets[@]} -eq 4 ]] || return 1
    for o in "${octets[@]}"; do
        [[ "$o" =~ ^[0-9]+$ ]] || return 1
        [[ ${#o} -gt 1 && "${o:0:1}" == "0" ]] && return 1
        (( o >= 0 && o <= 255 )) || return 1
    done
    return 0
}

is_hostname() {
    local h="$1"
    [[ "$h" =~ ^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)*$ ]]
}

read_target() {
    if [[ ! -r "$TARGET_FILE" || ! -s "$TARGET_FILE" ]]; then
        return 1
    fi
    sed -n 's/^[[:space:]]*//;s/[[:space:]]*$//;/./p;q' "$TARGET_FILE" 2>/dev/null
}

# ── Main status output ────────────────────────────────────────────────
status() {
    local target host
    target="$(read_target)" || { echo "$ICON_NONE No target"; return; }
    [[ -z "$target" ]] && { echo "$ICON_NONE No target"; return; }

    # Strip port if present
    host="$target"
    if [[ "$target" == *:* && "${target##*:}" =~ ^[0-9]+$ ]]; then
        host="${target%:*}"
    fi
    if is_ipv4 "$host"; then
        echo "$ICON_IP $target"
    elif is_hostname "$host"; then
        echo "$ICON_HOST $target"
    else
        echo "$ICON_INVALID Invalid"
    fi
}

# ── Commands ──────────────────────────────────────────────────────────
case "${1:-}" in
    set)
        if [[ -n "${2:-}" ]]; then
            printf '%s\n' "$2" > "$TARGET_FILE"
        else
            # DWM standard: use dmenu if no arg given
            target="$(dmenu -p 'Set target:' < /dev/null)" || exit 0
            [[ -n "$target" ]] && printf '%s\n' "$target" > "$TARGET_FILE"
        fi
        # Signal dwmblocks to refresh immediately (block 16 = SIGUSR1+16)
        pkill -RTMIN+16 dwmblocks 2>/dev/null || true
        ;;
    clear)
        rm -f "$TARGET_FILE"
        pkill -RTMIN+16 dwmblocks 2>/dev/null || true
        ;;
    *)
        status
        ;;
esac
