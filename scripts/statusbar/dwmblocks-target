#!/usr/bin/env bash
# dwmblocks module: HTB target indicator
# Usage: dwmblocks-target          # output for DWM bar
#        dwmblocks-target set IP  # set target via dmenu or args
#        dwmblocks-target clear   # clear target
set -euo pipefail

TARGET_FILE="${TARGET_FILE:-$HOME/.target}"

# ── Dmenu appearance ──────────────────────────────────────────────────
# Change the font name/size here to whatever is installed on your system.
# Check available fonts with: fc-list | grep -i "font name"
DMENU_FONT="${DMENU_FONT:-JetBrainsMono Nerd Font-20}"

# ── Icons (Nerd Font or FontAwesome) ──────────────────────────────────
ICON_NONE=""
ICON_IP=""
ICON_HOST=""
ICON_INVALID=""

# ── Validation ────────────────────────────────────────────────────────
is_ipv4() {
    local ip="$1" IFS='.' octets
    read -ra octets <<< "$ip"
    [[ ${#octets[@]} -eq 4 ]] || return 1
    for o in "${octets[@]}"; do
        [[ "$o" =~ ^[0-9]+$ ]] || return 1
        [[ ${#o} -gt 1 && "${o:0:1}" == "0" ]] && return 1
        (( o >= 0 && o <= 255 )) || return 1
    done
    return 0
}

is_hostname() {
    local h="$1"
    [[ "$h" =~ ^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)*$ ]]
}

read_target() {
    if [[ ! -r "$TARGET_FILE" || ! -s "$TARGET_FILE" ]]; then
        return 1
    fi
    sed -n 's/^[[:space:]]*//;s/[[:space:]]*$//;/./p;q' "$TARGET_FILE" 2>/dev/null
}

# ── Reverse DNS (with timeout so bar never freezes) ───────────────────
resolve_ip() {
    local ip="$1" host
    if command -v timeout >/dev/null 2>&1; then
        host=$(timeout 1 getent hosts "$ip" 2>/dev/null | awk 'NR==1 {print $2}')
    else
        host=$(getent hosts "$ip" 2>/dev/null | awk 'NR==1 {print $2}')
    fi
    [[ -n "$host" && "$host" != "$ip" ]] && printf '%s' "$host"
}

# ── Main status output ────────────────────────────────────────────────
status() {
    local target host resolved
    target="$(read_target)" || { echo "$ICON_NONE No target"; return; }
    [[ -z "$target" ]] && { echo "$ICON_NONE No target"; return; }

    # Strip port if present (e.g., 127.0.0.1:8080)
    host="$target"
    if [[ "$target" == *:* && "${target##*:}" =~ ^[0-9]+$ ]]; then
        host="${target%:*}"
    fi

    if is_ipv4 "$host"; then
        resolved=$(resolve_ip "$host")
        if [[ -n "$resolved" ]]; then
            echo "$ICON_IP $resolved - $target"
        else
            echo "$ICON_IP $target"
        fi
    elif is_hostname "$host"; then
        echo "$ICON_HOST $target"
    else
        echo "$ICON_INVALID Invalid"
    fi
}

# ── Commands ──────────────────────────────────────────────────────────
case "${1:-}" in
    set)
        if [[ -n "${2:-}" ]]; then
            printf '%s\n' "$2" > "$TARGET_FILE"
        else
            target="$(dmenu -fn "$DMENU_FONT" -p 'Set target:' < /dev/null)" || exit 0
            [[ -n "$target" ]] && printf '%s\n' "$target" > "$TARGET_FILE"
        fi
        pkill -RTMIN+16 dwmblocks 2>/dev/null || true
        ;;
    clear)
        rm -f "$TARGET_FILE"
        pkill -RTMIN+16 dwmblocks 2>/dev/null || true
        ;;
    *)
        status
        ;;
esac
