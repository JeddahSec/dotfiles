#!/bin/sh

TARGET_FILE="${TARGET_FILE:-$HOME/.target}"
ICON_VPN=""
ICON_OFFLINE=""

# ── Get tun0 IP ───────────────────────────────────────────────────────
vpn_ip=$(ip -o -4 addr show tun0 2>/dev/null | awk '{split($4,a,"/"); print a[1]}')

# ── Commands: set / clear target ──────────────────────────────────────
case "${1:-}" in
    set)
        if [ -n "${2:-}" ]; then
            printf '%s\n' "$2" > "$TARGET_FILE"
        else
            _t=$(dmenu -p 'Target:' < /dev/null) || exit 0
            [ -n "$_t" ] && printf '%s\n' "$_t" > "$TARGET_FILE"
        fi
        pkill -RTMIN+7 dwmblocks 2>/dev/null
        exit 0
        ;;
    clear)
        rm -f "$TARGET_FILE"
        pkill -RTMIN+7 dwmblocks 2>/dev/null
        exit 0
        ;;
esac

# ── Main bar output ───────────────────────────────────────────────────
if [ -n "$vpn_ip" ]; then
    printf '%s %s\n' "$ICON_VPN" "$vpn_ip"
else
    printf '%s Offline\n' "$ICON_OFFLINE"
fi

# ── Click handlers ────────────────────────────────────────────────────
case "${BLOCK_BUTTON:-}" in
    1)
        # Left click: info terminal
        setsid -f "${TERMINAL:-st}" -e sh -c "
            echo '=== tun0 ==='
            ip addr show tun0 2>/dev/null || echo 'No tun0'
            echo
            echo '=== Target ==='
            cat '$TARGET_FILE' 2>/dev/null || echo 'None'
            echo
            echo 'Press any key...'
            read -n1
        " >/dev/null 2>&1
        ;;
    2)
        # Middle click: set target via dmenu
        _t=$(dmenu -p 'Set target:' < /dev/null) || exit 0
        [ -n "$_t" ] && printf '%s\n' "$_t" > "$TARGET_FILE"
        pkill -RTMIN+7 dwmblocks 2>/dev/null
        ;;
    3)
        # Right click: notification
        target=$(cat "$TARGET_FILE" 2>/dev/null)
        notify-send -t 4000 "VPN & Target" "VPN: ${vpn_ip:-Offline}\nTarget: ${target:-None}"
        ;;
    6)
        # Shift + left click: edit script
        setsid -f "${TERMINAL:-st}" -e "${EDITOR:-nvim}" "$0" >/dev/null 2>&1
        ;;
esac
