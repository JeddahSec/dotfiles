#!/usr/bin/env bash
set -euo pipefail

# ── Config (override via environment) ─────────────────────────────────
ICON="${DATETIME_ICON:-}"          # Nerd Font clock, or use "🕐"
FORMAT="${DATETIME_FORMAT:-%A, %-d %B %Y %I:%M %p}"
# Alternative compact format: "%a %d %b %H:%M"
# Alternative 24h format:    "%A, %-d %B %Y %H:%M"

# Force English day/month names regardless of system locale
# Comment out if you prefer your native locale
export LC_TIME=en_US.UTF-8

# ── Output ────────────────────────────────────────────────────────────
printf '%s %s\n' "$ICON" "$(date "+$FORMAT")"
