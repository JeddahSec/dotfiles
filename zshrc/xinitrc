#!/bin/sh

prefix="/usr"
exec_prefix="${prefix}"
xrdb="xrdb"
xinitdir="/etc/X11/xinit"
xclock="xclock"
xterm="xterm"
twm="twm"
xmodmap="xmodmap"

userresources="$HOME/.Xresources"
usermodmap="$HOME/.Xmodmap"
sysresources="$xinitdir/.Xresources"
sysmodmap="$xinitdir/.Xmodmap"

# Merge in defaults and keymaps
if [ -f "$sysresources" ]; then
    if [ -x /usr/bin/cpp ] ; then
        "$xrdb" -merge "$sysresources"
    else
        "$xrdb" -nocpp -merge "$sysresources"
    fi
fi

if [ -f "$sysmodmap" ]; then
    "$xmodmap" "$sysmodmap"
fi

if [ -f "$userresources" ]; then
    if [ -x /usr/bin/cpp ] ; then
        "$xrdb" -merge "$userresources"
    else
        "$xrdb" -nocpp -merge "$userresources"
    fi
fi

if [ -f "$usermodmap" ]; then
    "$xmodmap" "$usermodmap"
fi

# Start Xinit scripts (Important for Freedesktop / D-Bus setup)
if [ -d "$xinitdir"/xinitrc.d ] ; then
    for f in "$xinitdir/xinitrc.d"/?*.sh ; do
        [ -x "$f" ] && . "$f"
    done
    unset f
fi

# =========================================================
# 1. Environment Variables for File Chooser & Portals
# =========================================================
export XDG_CURRENT_DESKTOP=GNOME
export XDG_SESSION_TYPE=x11
export GTK_USE_PORTAL=1

# Update DBus & Systemd environment variables
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd --all
fi

# Restart desktop portal services to pick up new environment
systemctl --user restart xdg-desktop-portal-gtk xdg-desktop-portal 2>/dev/null &


# =========================================================
# 2. Background Programs
# =========================================================
# Screen Saver & Power Management
xset s off &
xset -dpms &

# Notifications
dunst &

# Compositor & Status Bar
picom -f &
dwmblocks &

# Wallpaper & Color Scheme
~/.local/src/statusbar/pywal16 &
nitrogen --restore &

# Tray Applications
udiskie -t &
nm-applet &


# =========================================================
# 3. Execute DWM with DBus Session
# =========================================================
# We wrap DWM inside dbus-run-session to ensure full D-Bus support
while true; do
    dbus-run-session dwm >/dev/null 2>&1
done
