<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>ReactTheme</string>
	<key>settings</key>
	<array>
		<!-- Global Editor Settings -->
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#282c34</string>
				<key>foreground</key>
				<string>#a7a7a8</string>
				<key>caret</key>
				<string>#61dafb</string>
				<key>lineHighlight</key>
				<string>#1e2127</string>
				<key>selection</key>
				<string>#353b45</string>
			</dict>
		</dict>

		<!-- Comments -->
		<dict>
			<key>name</key>
			<string>Comment</string>
			<key>scope</key>
			<string>comment, punctuation.definition.comment</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#3e4451</string>
				<key>fontStyle</key>
				<string>italic</string>
			</dict>
		</dict>

		<!-- Strings -->
		<dict>
			<key>name</key>
			<string>String</string>
			<key>scope</key>
			<string>string, punctuation.definition.string</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#8dc891</string>
			</dict>
		</dict>

		<!-- Keywords & Storage -->
		<dict>
			<key>name</key>
			<string>Keyword</string>
			<key>scope</key>
			<string>keyword, storage.type, storage.modifier</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#c5a5c5</string>
			</dict>
		</dict>

		<!-- Functions -->
		<dict>
			<key>name</key>
			<string>Functions</string>
			<key>scope</key>
			<string>entity.name.function, support.function, meta.function-call</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#79b6f2</string>
			</dict>
		</dict>

		<!-- Types / Classes -->
		<dict>
			<key>name</key>
			<string>Type</string>
			<key>scope</key>
			<string>entity.name.type, entity.name.class, support.type, support.class</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#fac863</string>
			</dict>
		</dict>

		<!-- Constants & Booleans -->
		<dict>
			<key>name</key>
			<string>Constant</string>
			<key>scope</key>
			<string>constant, constant.numeric, constant.language, constant.character</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#8be9ee</string>
			</dict>
		</dict>

		<!-- Booleans / Special Constants -->
		<dict>
			<key>name</key>
			<string>Boolean</string>
			<key>scope</key>
			<string>constant.language.boolean</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ff8b50</string>
			</dict>
		</dict>

		<!-- JSX Tags / Components -->
		<dict>
			<key>name</key>
			<string>Tags</string>
			<key>scope</key>
			<string>entity.name.tag, entity.name.tag.jsx, support.class.component</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#fc929e</string>
			</dict>
		</dict>

		<!-- Punctuation -->
		<dict>
			<key>name</key>
			<string>Punctuation</string>
			<key>scope</key>
			<string>punctuation, meta.brace</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#88c6be</string>
			</dict>
		</dict>

		<!-- Operators -->
		<dict>
			<key>name</key>
			<string>Operators</string>
			<key>scope</key>
			<string>keyword.operator</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#a7a7a8</string>
			</dict>
		</dict>

		<!-- Entities -->
		<dict>
			<key>name</key>
			<string>Entities</string>
			<key>scope</key>
			<string>entity.other.attribute-name, entity.name.section</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#d67c9b</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
